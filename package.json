{
  "name": "dsh-context-fold",
  "version": "0.1.0",
  "description": "Selective range context folding for DeepSeek Harness: extract verification detours into editable dual-layer Markdown files and replace them in-place on the model surface while keeping full human transcript.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-management",
    "context-folding",
    "compaction",
    "markdown"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "author": "mioakiyama0809-coder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mioakiyama0809-coder/dsh-context-fold.git"
  },
  "homepage": "https://github.com/mioakiyama0809-coder/dsh-context-fold#readme",
  "bugs": {
    "url": "https://github.com/mioakiyama0809-coder/dsh-context-fold/issues"
  }
}
